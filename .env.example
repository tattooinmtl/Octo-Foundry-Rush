# Copy to .env and fill in. .env is git-ignored - never commit real keys.
# Only the providers you use need a key. A key pasted in the in-game Settings
# overrides these per request and is never stored on the server.

# Which provider the menu shows as the default (minimax | nvidia | reflection | agnes)
FORGE_PROVIDER=minimax

# MiniMax - https://api.minimax.io/v1 (OpenAI-compatible)
MINIMAX_API_KEY=
MINIMAX_API_HOST=https://api.minimax.io
MINIMAX_MODEL=MiniMax-M3.1-Flash

# NVIDIA NIM - https://integrate.api.nvidia.com/v1 (OpenAI-compatible), keys from build.nvidia.com
NVIDIA_API_KEY=
# NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# Reflection AI - https://api.reflection.ai/openai/v1 (OpenAI-compatible).
# Reflection keys are very long (~3x a normal key); paste the whole thing on one line.
REFLECTION_API_KEY=
# REFLECTION_MODEL=Beam-1.0-501B-A23B

# Agnes AI - https://apihub.agnes-ai.com/v1 (OpenAI-compatible)
AGNES_API_KEY=
# AGNES_MODEL=agnes-2.5-flash

# Custom provider defaults (the in-game form overrides these)
CUSTOM_API_KEY=
# CUSTOM_BASE_URL=
# CUSTOM_COMPAT=openai
# CUSTOM_MODEL=

# Forge reliability knobs
# FORGE_TIMEOUT_MS=45000   # per model call
# FORGE_RETRIES=2          # retries on timeouts / 5xx / rate limits (never on bad keys or quota)

# The custom provider form makes the SERVER call the URL you type, so LAN /
# loopback addresses are blocked by default. Set to 1 to allow e.g. a local Ollama.
# ALLOW_PRIVATE_PROVIDER_URLS=0

PORT=3000
